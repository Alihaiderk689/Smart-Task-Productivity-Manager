# Copy this file to .env (kept out of git) and fill in real values before
# running `docker compose up`.

# --- Postgres (used by the `db` service, and assembled into DATABASE_URL_DEV below) ---
# NOTE: settings.py overrides DATABASES with POSTGRES_HOST/PORT whenever
# POSTGRES_DB is set in the environment (see backend/config/settings.py)
# -- since this whole .env is injected into the backend container too,
# POSTGRES_HOST/PORT must point at the `db` service, not localhost.
POSTGRES_DB=taskmanager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Points at the `db` service by name -- must match the POSTGRES_* values above.
DATABASE_URL_DEV=postgresql://postgres:change-me@db:5432/taskmanager_db
DATABASE_URL_PROD=

# Points at the `redis` service by name.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Base URL of the frontend container (nginx), used to build links in emails
# and for CORS.
FRONTEND_URL=http://localhost:8080

# --- Email (optional; password reset links, task reminders) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Google OAuth (optional) -- same client ID on both sides ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Cloudinary (optional; falls back to local disk storage in /app/media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin Copilot LLM providers (optional; copilot degrades gracefully without these) ---
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
