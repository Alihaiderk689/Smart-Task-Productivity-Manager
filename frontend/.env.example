# Base URL of the backend API
VITE_API_ROOT=http://127.0.0.1:8000/api

# Google OAuth client ID (from console.cloud.google.com), used by the
# "Sign in with Google" button on the login/register pages. Must match
# GOOGLE_CLIENT_ID in backend/.env -- they are the same client ID. Leave
# blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
